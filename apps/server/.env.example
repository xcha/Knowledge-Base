# ============ 数据库 ============
DATABASE_URL=

# ============ AI 模型 ============
# Claude（必填）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# OpenAI（可选，用于 GPT-4o 等模型）
OPENAI_API_KEY=

# DeepSeek（可选，用于 DeepSeek 模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Voyage AI（必填，用于文档向量化）
VOYAGE_API_KEY=

# ============ 认证 ============
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ============ 应用 ============
PORT=3001
CORS_ORIGINS=

# ============ 支付宝沙箱（可选） ============
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_RETURN_URL=http://localhost:3000/dashboard/membership

# ============ 阿里云短信（可选，不配置则以日志模式运行） ============
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SMS_REGION=cn-hangzhou
ALIBABA_CLOUD_SMS_SIGN_NAME=
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=
